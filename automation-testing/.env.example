# dev | stg | prd (mặc định dev)
ENV=dev

# tài khoản cố định, đang hoạt động (fixture `account`)
# password có ký tự # thì bọc trong nháy đơn: DEV_USER_PASSWORD='abc#123' (không bọc thì dotenv cắt từ #)
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
STG_USER_EMAIL=
STG_USER_PASSWORD=

# Postgres dev mà app đang dùng. Test seed phiên đăng nhập và dọn dữ liệu trực tiếp qua pg (src/utils/auth-state.ts,
# src/utils/db-cleanup.ts), nên CHỈ trỏ vào DB dev bỏ đi được, không bao giờ stg/prd.
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchcv

# Tùy chọn — ghi đè URL web / API của ENV hiện tại cho một lượt chạy (vd app chạy trong git worktree ở cổng khác).
# API phải cho phép origin đó qua CLIENT_ORIGIN của server.
# E2E_BASE_URL=http://localhost:5302
# E2E_API_BASE=http://localhost:5202/api/v1
