VITE_API_BASE_URL=http://localhost:5200/api/v1
VITE_DEFAULT_LOCALE=en

# E2E test DB (Playwright db-cleanup). Set the real local URL in .env (gitignored).
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchcv

# Optional — base URL Playwright tests hit. Only needed when the dev server is
# not on :5300 (e.g. a git worktree running beside the main checkout). The API
# server must allow that origin via its own CLIENT_ORIGIN env var.
E2E_BASE_URL=http://localhost:5300
