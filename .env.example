# Biến môi trường — BẢN ĐỒ TOÀN DỰ ÁN.
#
# ⚠️ File này KHÔNG phải file để copy. `web-app-match-cv` là monorepo hai workspace,
#    mỗi bên có `.env` riêng:
#
#      cd server && cp .env.example .env
#      cd client && cp .env.example .env
#
#    Root không đọc biến môi trường nào (chỉ có husky). File này tồn tại để trả lời
#    "cần biến nào để chạy được dự án này" ở một chỗ, và để `docs-regen.sh` đối chiếu
#    được với code.
#
# Trả lời câu hỏi: cần biến nào để chạy được dự án này?
# Trạng thái:     🟢 đủ (2026-09-03)
# Cập nhật khi:   code đọc một biến mới (process.env.X / import.meta.env.X)
#
# HAI QUY TẮC
#   1. Không chứa giá trị thật. Chỉ tên biến + cách lấy giá trị.
#   2. Danh sách này khớp CODE, không khớp tài liệu thiết kế. Biến code không còn
#      đọc thì xoá; biến code đọc mà thiếu ở đây là một cái bẫy.

# ─────────────────────────────────────────────────────────────
# server/ — bắt buộc
# ─────────────────────────────────────────────────────────────

# đọc bởi:      server/src/config, server/prisma
# bắt buộc khi: chạy app, chạy migration, chạy test cần DB
# lấy ở đâu:    PostgreSQL local, database `matchcv`
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchcv?schema=public

# đọc bởi:      server/src/main.ts
# bắt buộc khi: chạy app. Mặc định 5200
# PORT=5200

# đọc bởi:      server/src/main.ts (CORS)
# bắt buộc khi: chạy app. Phải trùng origin thật của client
# CLIENT_ORIGIN=http://localhost:5300

# ─────────────────────────────────────────────────────────────
# server/ — tuỳ chọn lúc khởi động, bắt buộc lúc gọi AI
# ─────────────────────────────────────────────────────────────

# đọc bởi:      server/src/modules/ai
# bắt buộc khi: gọi POST /match mà user không có credential riêng (khoá fallback hệ thống)
# lấy ở đâu:    https://openrouter.ai
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small

# đọc bởi:      server/src/modules/ai-credentials
# bắt buộc khi: gọi /ai-credentials. base64 của ĐÚNG 32 byte
# lấy ở đâu:    openssl rand -base64 32
# ⚠️ Đổi giá trị này là mọi credential đã lưu hết giải mã được — xoay khoá bằng cách
#    nhập lại từng credential. TUYỆT ĐỐI không commit giá trị thật (NFR-SEC-04).
# CREDENTIAL_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# client/ — bắt buộc
# ─────────────────────────────────────────────────────────────

# đọc bởi:      client/src/requests
# bắt buộc khi: chạy client
# VITE_API_BASE_URL=http://localhost:5200/api/v1

# đọc bởi:      client/src/i18n
# mặc định:     en
# VITE_DEFAULT_LOCALE=en

# ─────────────────────────────────────────────────────────────
# Chỉ dùng khi chạy test
# ─────────────────────────────────────────────────────────────

# đọc bởi:      client/e2e/**/*.ts (db-cleanup của Playwright)
# bắt buộc khi: chạy `yarn test:e2e` trong client/
# E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchcv

# đọc bởi:      client/playwright.config.ts
# bắt buộc khi: dev server KHÔNG ở :5300 (ví dụ chạy trong git worktree cạnh bản chính).
#               Lúc đó server phải cho phép origin đó qua CLIENT_ORIGIN của nó
# mặc định:     http://localhost:5300
# E2E_BASE_URL=http://localhost:5300

# đọc bởi:      client/e2e/**/helpers.ts (seed qua API)
# bắt buộc khi: API server không ở :5200
# mặc định:     http://localhost:5200/api/v1
# E2E_API_BASE=http://localhost:5200/api/v1

# ─────────────────────────────────────────────────────────────
# KHÔNG phải biến môi trường
# ─────────────────────────────────────────────────────────────
#
# `DEV` — đây là `import.meta.env.DEV` do Vite sinh lúc build, không đọc từ `.env`.
# Đừng thêm nó vào file `.env` nào.
