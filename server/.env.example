PORT=5200
CLIENT_ORIGIN=http://localhost:5300
# --- DB ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchcv?schema=public
# --- AI provider (Plan 2 matching engine) — OpenRouter (OpenAI-compatible), optional at boot, required at /match ---
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_CHAT_MODEL=openai/gpt-4o-mini
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# --- Credential encryption (BYO AI credentials) — base64 of EXACTLY 32 bytes.
# Generate with: openssl rand -base64 32
# Optional at boot; required when calling /ai-credentials. NEVER commit a real value.
# Changing it makes every stored credential undecryptable — rotate by re-entering keys.
# CREDENTIAL_ENCRYPTION_KEY=
# --- Sign-in through Ducker ID (ADR-0022). Optional at boot; /auth/login and
# /auth/callback answer 503 without the OIDC_* group. Register the app in Ducker
# ID admin (/admin/apps); the redirect URI must match EXACTLY.
# OIDC_ISSUER=http://localhost:5000
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:5200/api/v1/auth/callback
# At least 32 chars (openssl rand -base64 48). Seals the mcv_oauth cookie and keys the guest IP HMAC.
# SESSION_SECRET=
# SESSION_TTL_DAYS=7
# GUEST_TTL_HOURS=24
# GUEST_MATCH_LIMIT_PER_DAY=5
